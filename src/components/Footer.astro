---
import { site, navigation } from "@/data/site";
import { asset } from "@/utils/asset";

const legal = [
  { label: "Оферта",    href: asset("/offer/") },
  { label: "Политика",  href: asset("/privacy/") },
  { label: "Возврат",   href: asset("/refund/") },
  { label: "Cookies",   href: asset("/cookies/") },
  { label: "Контакты",  href: asset("/contacts/") },
];

const social = [
  { label: "Telegram", href: site.telegramUrl },
  { label: "VK",       href: site.vkUrl },
  { label: "Поддержка", href: `mailto:${site.supportEmail}` },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">

    <!-- Бренд -->
    <div class="footer-brand-col">
      <a class="brand footer-brand" href={asset("/")} aria-label="На главную">
        <span class="brand-mark" aria-hidden="true">
          <span>QA</span>
          <i></i>
        </span>
        <span class="brand-word">
          <strong>QA<span>AI</span></strong>
          <em>practice kit</em>
        </span>
      </a>
      <p class="footer-tagline">
        Практический набор для QA: AI без слепой веры, первые проверки и проект для портфолио.
      </p>
      <a class="footer-cta" href="#pricing">Получить набор →</a>
    </div>

    <!-- Навигация -->
    <div class="footer-col">
      <p class="footer-col-title">Разделы</p>
      <ul>
        {navigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Контакты и соцсети -->
    <div class="footer-col">
      <p class="footer-col-title">Контакты</p>
      <ul>
        {social.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Юридическое -->
    <div class="footer-col">
      <p class="footer-col-title">Документы</p>
      <ul>
        {legal.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>

  </div>

  <!-- Нижняя бар -->
  <div class="footer-bar">
    <p>© {year} {site.name}. Все права защищены.</p>
    <a
      class="dev-credit"
      href="https://neon-dev.ru/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Сайт разработан Neon Dev"
    >
      <span class="dev-credit-dot" aria-hidden="true"></span>
      Разработано в <strong>Neon Dev</strong>
      <em>online</em>
    </a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--dark);
    color: rgba(255, 253, 247, 0.55);
    margin-top: 0;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 2.5rem 3rem;
    width: min(var(--max), calc(100% - 36px));
    margin: 0 auto;
    padding: 52px 0 40px;
    border-bottom: 1px solid rgba(255, 253, 247, 0.08);
  }

  /* ── Brand column ── */
  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-brand {
    color: var(--paper);
  }

  .footer-tagline {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(255, 253, 247, 0.45);
    max-width: 260px;
  }

  .footer-cta {
    display: inline-block;
    width: fit-content;
    padding: 8px 18px;
    background: var(--orange);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    border-radius: 100px;
    text-decoration: none;
    transition: opacity 0.18s ease;
  }

  .footer-cta:hover { opacity: 0.88; }

  /* ── Link columns ── */
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-col-title {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 253, 247, 0.3);
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-col a {
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(255, 253, 247, 0.6);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-col a:hover { color: var(--paper); }

  /* ── Bottom bar ── */
  .footer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(var(--max), calc(100% - 36px));
    margin: 0 auto;
    padding: 20px 0 28px;
    font-size: 0.78rem;
  }

  .footer-bar p { margin: 0; }

  /* dev-credit inherits global styles */
  .dev-credit {
    color: rgba(255, 253, 247, 0.4);
    border-color: rgba(255, 253, 247, 0.1);
    background: rgba(255, 253, 247, 0.04);
    font-size: 0.78rem;
  }

  .dev-credit:hover { color: rgba(255, 253, 247, 0.7); }

  .dev-credit-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    flex-shrink: 0;
  }

  /* ── Tablet ── */
  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .footer-brand-col {
      grid-column: 1 / -1;
    }

    .footer-tagline { max-width: 100%; }
  }

  /* ── Mobile ── */
  @media (max-width: 540px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      padding-top: 40px;
    }

    .footer-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
      padding-bottom: 32px;
    }
  }
</style>
