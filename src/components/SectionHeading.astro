---
interface Props {
  eyebrow?: string;
  title?: string;
  titleHtml?: string;
  text?: string;
}

const { eyebrow, title, titleHtml, text } = Astro.props;
---

<div class="section-heading reveal">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  {titleHtml ? <h2 set:html={titleHtml} /> : <h2>{title}</h2>}
  {text && <p>{text}</p>}
</div>
