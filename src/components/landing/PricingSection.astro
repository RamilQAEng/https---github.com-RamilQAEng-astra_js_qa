---
import SectionHeading from "@/components/SectionHeading.astro";
import { leadMagnet, offers } from "@/data/site";
---

<section class="section" id="pricing">
  <SectionHeading
    eyebrow="Тарифы"
    title="Выбери формат"
    text="Основной тариф — для самостоятельной практики. PRO — если хочешь личный разбор CV, проекта и следующих шагов."
  />
  <div class="pricing-grid">
    {offers.map((offer) => (
      <article class:list={["price-card paid-price-card reveal", { highlighted: offer.highlighted }]}>
        <div class="price-card-top">
          <img class="coin-icon" src="/images/pixel-coin.svg" alt="" loading="lazy" />
          {offer.highlighted && <span class="badge">Рекомендуемый</span>}
        </div>
        <div>
          <h3>{offer.name}</h3>
          <p>{offer.description}</p>
        </div>
        <div class="price-line">
          {offer.oldPrice && <span>{offer.oldPrice}</span>}
          <strong>{offer.price}</strong>
        </div>
        <ul>
          {offer.features.map((feature) => <li>{feature}</li>)}
        </ul>
        <a
          class="button primary full paid-tariff-button"
          href={offer.checkoutUrl}
          data-goal={offer.goalId}
          data-plan={offer.id}
        >
          {offer.cta}
        </a>
      </article>
    ))}
  </div>
  <div class="cat-banner reveal" id="free-guide">
    <img
      class="cat-banner-bg"
      src="/images/pixel-cat-text-right.webp"
      alt="Пиксельный кот-QA с баг-репортом и инструментами тестирования"
      loading="lazy"
      decoding="async"
    />
    <div class="cat-banner-copy">
      <span class="cat-banner-tag">Бонус-уровень • {leadMagnet.price}</span>
      <h3>{leadMagnet.name}</h3>
      <p>{leadMagnet.description}</p>
      <a
        class="button primary"
        href={leadMagnet.href}
        data-goal={leadMagnet.goalId}
        download
      >
        {leadMagnet.cta}
      </a>
    </div>
  </div>
</section>
