---
import SectionHeading from "@/components/SectionHeading.astro";
import { offers } from "@/data/site";

const slides = [
  { src: "/images/0PDF_MAIN.webp", label: "Обложка" },
  { src: "/images/1PDF_blog.webp", label: "Стр. 1" },
  { src: "/images/2PDF.webp", label: "Стр. 2" },
  { src: "/images/3PDF.webp", label: "Стр. 3" },
];

const facts = [
  { value: "25", label: "готовых промтов" },
  { value: "30", label: "дней маршрут" },
  { value: "4", label: "модуля практики" },
];
---

<section class="section preview-section" id="preview">
  <SectionHeading
    eyebrow="Загляни внутрь"
    titleHtml="Не покупай вслепую — <span class='accent-text'>посмотри на материал</span>"
    text="Стиль, структура и глубина — всё видно до оплаты."
  />

  <div class="preview-stage reveal">

    <!-- Главное изображение -->
    <div class="preview-main">
      <div class="preview-frame">
        <img
          id="preview-main-img"
          src={slides[0].src}
          alt="Превью AI QA Practice Kit"
          width="600"
          height="780"
          loading="lazy"
          decoding="async"
        />
        <div class="preview-badge">PDF · 30 дней</div>
      </div>
      <a class="button primary preview-cta" href="#pricing">
        Получить за {offers[0].price}
      </a>
    </div>

    <!-- Правая панель: факты + сетка миниатюр -->
    <div class="preview-panel">

      <div class="preview-facts">
        {facts.map((f) => (
          <div class="preview-fact">
            <strong>{f.value}</strong>
            <span>{f.label}</span>
          </div>
        ))}
      </div>

      <p class="preview-panel-label">Страницы набора</p>

      <div class="preview-grid" role="list" aria-label="Страницы набора">
        {slides.map((slide, i) => (
          <button
            class:list={["preview-thumb", { active: i === 0 }]}
            data-src={slide.src}
            role="listitem"
            aria-label={`Показать: ${slide.label}`}
            type="button"
          >
            <div class="thumb-img-wrap">
              <img src={slide.src} alt={slide.label} loading="lazy" decoding="async" />
            </div>
            <span>{slide.label}</span>
          </button>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  .preview-section {
    overflow: hidden;
  }

  .preview-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  /* ── Main image ── */
  .preview-main {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1rem;
    width: 100%;
    max-width: 420px;
  }

  .preview-frame {
    position: relative;
    width: 100%;
    border-radius: 18px;
    overflow: hidden;
    box-shadow:
      0 2px 0 rgba(255, 255, 255, 0.9) inset,
      0 32px 80px rgba(23, 25, 23, 0.18),
      0 0 0 1.5px rgba(23, 25, 23, 0.08);
    background: #1a1a1a;
  }

  #preview-main-img {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 0.22s ease;
  }

  #preview-main-img.fading {
    opacity: 0;
  }

  .preview-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: var(--orange);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 100px;
  }

  .preview-cta {
    text-align: center;
  }

  /* ── Right panel ── */
  .preview-panel {
    width: 100%;
    max-width: 420px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Facts row */
  .preview-facts {
    display: flex;
    gap: 0.75rem;
  }

  .preview-fact {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    background: var(--paper);
    border: 1.5px solid var(--line);
    border-radius: 14px;
    padding: 0.9rem 0.5rem;
    text-align: center;
  }

  .preview-fact strong {
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1;
    color: var(--orange);
  }

  .preview-fact span {
    font-size: 0.7rem;
    color: var(--muted);
    font-weight: 600;
    line-height: 1.3;
  }

  /* Thumbnails label */
  .preview-panel-label {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* 2×2 grid */
  .preview-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.625rem;
  }

  .preview-thumb {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    background: var(--paper);
    border: 1.5px solid var(--line);
    border-radius: 12px;
    padding: 6px 6px 8px;
    cursor: pointer;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.15s ease;
  }

  .preview-thumb:hover {
    border-color: rgba(238, 107, 58, 0.45);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(238, 107, 58, 0.12);
  }

  .preview-thumb.active {
    border-color: var(--orange);
    box-shadow: 0 0 0 3px rgba(238, 107, 58, 0.15);
  }

  .thumb-img-wrap {
    width: 100%;
    border-radius: 7px;
    overflow: hidden;
    background: #1a1a1a;
    aspect-ratio: 3 / 4;
  }

  .thumb-img-wrap img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .preview-thumb span {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--muted);
  }

  .preview-thumb.active span {
    color: var(--orange);
  }

  /* ── Desktop ── */
  @media (min-width: 860px) {
    .preview-stage {
      flex-direction: row;
      align-items: flex-start;
      justify-content: center;
      gap: 2.5rem;
    }

    .preview-main {
      max-width: 400px;
      flex-shrink: 0;
    }

    .preview-panel {
      max-width: 280px;
      flex-shrink: 0;
    }
  }
</style>

<script>
  const thumbs = document.querySelectorAll<HTMLButtonElement>(".preview-thumb");
  const mainImg = document.getElementById("preview-main-img") as HTMLImageElement | null;
  const frame = mainImg?.closest(".preview-frame") as HTMLElement | null;

  if (mainImg) {
    thumbs.forEach((thumb) => {
      thumb.addEventListener("click", () => {
        const src = thumb.dataset.src;
        if (!src) return;

        thumbs.forEach((t) => t.classList.remove("active"));
        thumb.classList.add("active");

        mainImg.classList.add("fading");
        setTimeout(() => {
          mainImg.src = src;
          mainImg.classList.remove("fading");
        }, 220);

        // На мобиле скроллим к главному изображению
        if (window.innerWidth < 860 && frame) {
          setTimeout(() => {
            frame.scrollIntoView({ behavior: "smooth", block: "start" });
          }, 50);
        }
      });
    });
  }
</script>
