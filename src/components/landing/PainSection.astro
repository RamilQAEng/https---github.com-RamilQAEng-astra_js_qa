---
import SectionHeading from "@/components/SectionHeading.astro";

const pains = [
  "Junior-задачи быстрее всего уходят в автоматизацию: чек-листы, test cases, простые баг-репорты.",
  "Работодателю всё чаще нужен QA, который понимает AI, автотесты и умеет ускорять процессы.",
  "Обычное резюме manual QA хуже выделяется среди кандидатов, если в нём нет инструментов и конкретных кейсов.",
  "Рынок в РФ стал осторожнее: меньше терпения к обучению с нуля, больше ожиданий к самостоятельности.",
];
---

<section class="section soft" id="pain">
  <SectionHeading
    eyebrow="Ситуация на рынке"
    title="Проблема не в том, что AI заменит всех. Проблема в том, что он уже меняет ожидания."
    text="Мотивация здесь простая: не паниковать, а быстро понять, какие навыки добавить, чтобы остаться полезным."
  />
  <div class="pain-grid">
    {pains.map((pain, index) => (
      <article class="dark-card reveal" style={`--delay:${index * 80}ms`}>
        <span>0{index + 1}</span>
        <p>{pain}</p>
      </article>
    ))}
  </div>
</section>
