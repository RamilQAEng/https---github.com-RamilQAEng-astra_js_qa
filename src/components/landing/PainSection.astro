---
import SectionHeading from "@/components/SectionHeading.astro";

const pains = [
  "AI уже помогает писать тесты, но QA всё равно должен понять: можно ли доверять этому результату.",
  "Manual QA всё чаще чувствует: рынок двигается в AI и automation, а понятного входа нет.",
  "Обычные тест-кейсы в портфолио уже слабее, чем проект, где ты показал работу с AI на практике.",
];
---

<section class="section soft" id="pain">
  <SectionHeading
    eyebrow="Ситуация на рынке"
    titleHtml="<span class='accent-text'>AI</span> не отменил QA. Но он уже изменил ожидания от <span class='accent-text'>QA</span>"
    text="Паниковать не нужно. Но если ChatGPT пишет тесты, а вакансии всё чаще требуют AI-инструменты, QA должен понимать, как использовать AI и где его проверять."
  />
  <div class="pain-grid">
    {pains.map((pain, index) => (
      <article class="dark-card reveal" style={`--delay:${index * 80}ms`}>
        <span>0{index + 1}</span>
        <p>{pain}</p>
      </article>
    ))}
  </div>
</section>
