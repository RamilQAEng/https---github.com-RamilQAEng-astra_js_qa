---
import { leadMagnet, offers } from "@/data/site";
---

<section class="hero section" id="top">
  <div class="hero-backdrop" aria-hidden="true">
    <span class="scan-ring ring-one"></span>
    <span class="scan-ring ring-two"></span>
    <span class="scan-line"></span>
  </div>
  <div class="hero-copy reveal">
    <p class="eyebrow">AI для QA • практический набор на 30 дней</p>
    <h1><span class="accent-text">AI</span> уже меняет <span class="accent-text">QA</span>. Научись использовать его раньше остальных</h1>
    <p class="hero-text">
      Если ты manual QA, junior или уже работаешь в тестировании, но чувствуешь,
      что AI и automation уходят вперёд — начни с понятного плана. За 30 дней
      разберёшься, где AI помогает QA, как проверять его ответы и как собрать
      практический проект для портфолио или работы.
    </p>
    <div class="mobile-hero-kit" aria-label="Что внутри AI QA набора">
      <div class="mobile-hero-kit__head">
        <img src="/images/pixel-map.svg" alt="" loading="lazy" decoding="async" />
        <div>
          <span>Roadmap 30 дней</span>
          <strong>Первые шаги без воды</strong>
        </div>
      </div>
      <div class="mobile-hero-kit__items">
        <span>AI в работе</span>
        <span>Первые проверки</span>
        <span>Проект в портфолио</span>
      </div>
    </div>
    <div class="hero-actions">
      <a
        class="button primary"
        href="#pricing"
        data-goal="paid_tariff_full"
      >
        Получить план и практику — {offers[0].price}
      </a>
      <a class="button ghost" href="#free-guide" data-goal={leadMagnet.goalId}>
        Забрать гайд бесплатно
      </a>
    </div>
  </div>
  <div class="hero-card human-hero-card reveal delay-1" aria-label="AI QA Starter Guide — что внутри гайда">
    <div class="human-visual">
      <img
        src="/images/image.webp"
        alt="AI QA Starter Guide для тестировщиков: как проверять ответы AI без слепой веры — что внутри гайда"
        width="1114"
        height="1026"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</section>
