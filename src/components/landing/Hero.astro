---
import { leadMagnet, offers } from "@/data/site";
---

<section class="hero section" id="top">
  <div class="hero-backdrop" aria-hidden="true">
    <span class="scan-ring ring-one"></span>
    <span class="scan-ring ring-two"></span>
    <span class="scan-line"></span>
  </div>
  <div class="hero-copy reveal">
    <p class="eyebrow">AI для QA • практический набор</p>
    <h1>Что делать QA, пока AI забирает рутину тестировщика</h1>
    <p class="hero-text">
      Не жди, пока AI обгонит — научись им управлять. Готовый набор: 25 промтов,
      PDF-гайд, шаблоны CV и план на 30 дней. Ускоряй требования, test cases,
      баг-репорты и готовься к интервью уже сегодня. Без курсов на полгода.
    </p>
    <div class="mobile-hero-kit" aria-label="Что внутри AI QA набора">
      <div class="mobile-hero-kit__head">
        <img src="/images/pixel-map.svg" alt="" loading="lazy" decoding="async" />
        <div>
          <span>Roadmap 30 дней</span>
          <strong>Первые шаги без воды</strong>
        </div>
      </div>
      <div class="mobile-hero-kit__items">
        <span>PDF-гайд</span>
        <span>25 промтов</span>
        <span>CV под AI QA</span>
      </div>
    </div>
    <div class="hero-actions">
      <a
        class="button primary"
        href="#pricing"
        data-goal="paid_tariff_full"
      >
        Забрать полный набор — {offers[0].price}
      </a>
      <a class="button ghost" href={leadMagnet.href} data-goal={leadMagnet.goalId} download>
        Сначала бесплатный мини-гайд →
      </a>
    </div>
  </div>
  <div class="hero-card human-hero-card reveal delay-1" aria-label="AI QA набор и авторский подход">
    <div class="human-visual">
      <img
        src="/images/hero-qa-specialist.jpg"
        alt="QA-специалист использует AI-инструменты в работе"
        loading="lazy"
        decoding="async"
      />
      <div class="hero-level-card">
        <span>Level 01</span>
        <strong>AI QA старт</strong>
        <p>25 промтов + roadmap</p>
      </div>
      <div class="pixel-orbit" aria-hidden="true">
        <img src="/images/pixel-robot.svg" alt="" />
        <img src="/images/pixel-trophy.svg" alt="" />
      </div>
    </div>
  </div>
</section>
