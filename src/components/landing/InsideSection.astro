---
import SectionHeading from "@/components/SectionHeading.astro";

const items = [
  {
    titleBefore: "План на ",
    titleAccent: "30 дней",
    meta: "практический маршрут",
    icon: "/images/pixel-scroll.svg",
    text: "Поймешь, что учить первым, что можно отложить и как не утонуть в инструментах. Отдельно для junior, manual и middle QA.",
    size: "large",
  },
  {
    titleBefore: "",
    titleAccent: "25 промтов",
    titleAfter: " для QA",
    meta: "копируй и применяй",
    icon: "/images/pixel-robot.svg",
    text: "Не \"напиши тесты\", а нормальные запросы для требований, рисков, тестов, bug report, review ответа AI и подготовки к релизу.",
    size: "tall",
  },
  {
    titleBefore: "",
    titleAccent: "AI QA",
    titleAfter: " project",
    meta: "для портфолио",
    icon: "/images/pixel-cv.svg",
    text: "Соберешь проект, который показывает: ты умеешь не только писать test cases, но и проверять AI, риски и качество ответа.",
    size: "wide",
  },
  {
    titleBefore: "",
    titleAccent: "CV",
    titleAfter: " и собеседование",
    meta: "под рынок РФ",
    icon: "/images/pixel-map.svg",
    text: "Шаблон резюме, сопроводительное письмо и ответы на вопросы, чтобы объяснить AI-навыки без пафоса и пустых слов.",
    size: "small",
  },
];
---

<section class="section" id="inside">
  <SectionHeading
    eyebrow="Что внутри"
    titleHtml="Не PDF про <span class='accent-text'>ChatGPT</span>, а рабочий набор <span class='accent-text'>QA</span> под рынок 2026"
    text="Внутри не обещание “AI все сделает за тебя”, а практический маршрут: поставить задачу, проверить ответ, собрать первые проверки, упаковать проект и резюме."
  />
  <div class="inside-grid bento-grid">
    {items.map((item, index) => (
      <article class={`content-card bento-card bento-${item.size} reveal`} style={`--delay: ${index * 90}ms`}>
        <img class="pixel-card-icon" src={item.icon} alt="" loading="lazy" />
        <div>
          <span>{item.meta}</span>
          <h3>{item.titleBefore}<em>{item.titleAccent}</em>{item.titleAfter}</h3>
        </div>
        <p>{item.text}</p>
        <a href="#pricing" aria-label={`Выбрать тариф для ${item.titleAccent}`}>↗</a>
      </article>
    ))}
  </div>
</section>
