---
import SectionHeading from "@/components/SectionHeading.astro";

const items = [
  {
    title: "PDF-гайд",
    meta: "25+ страниц",
    icon: "/images/pixel-scroll.svg",
    text: "Поймёшь за вечер, где AI реально ускоряет QA, а где он ошибается — без мифов и паники.",
  },
  {
    title: "Промты",
    meta: "25 шаблонов",
    icon: "/images/pixel-robot.svg",
    text: "Готовые шаблоны под тест-кейсы, баг-репорты, требования и автотесты — копируй и применяй.",
  },
  {
    title: "CV и письмо",
    meta: "2 шаблона",
    icon: "/images/pixel-cv.svg",
    text: "Упакуешь опыт на языке AI QA и начнёшь выделяться среди кандидатов — даже без automation.",
  },
  {
    title: "Roadmap",
    meta: "30 дней",
    icon: "/images/pixel-map.svg",
    text: "Получишь чёткий план на месяц вместо хаоса: что учить и в каком порядке, без распыления.",
  },
];
---

<section class="section" id="inside">
  <SectionHeading
    eyebrow="Что внутри"
    title="Четыре блока, которые превращают AI в твой рабочий инструмент"
    text="Не теория, а готовый пакет: открыл, забрал промты, обновил резюме — и пошёл применять в тот же день."
  />
  <div class="inside-grid">
    {items.map((item) => (
      <article class="content-card reveal">
        <img class="pixel-card-icon" src={item.icon} alt="" loading="lazy" />
        <div>
          <span>{item.meta}</span>
          <h3>{item.title}</h3>
        </div>
        <p>{item.text}</p>
        <a href="#pricing" aria-label={`Выбрать тариф для ${item.title}`}>↗</a>
      </article>
    ))}
  </div>
</section>
