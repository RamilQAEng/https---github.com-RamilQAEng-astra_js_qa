---
import SectionHeading from "@/components/SectionHeading.astro";

const items = [
  {
    title: "План на 30 дней",
    meta: "практический маршрут",
    icon: "/images/pixel-scroll.svg",
    text: "Поймёшь, что учить первым, что можно отложить и как не утонуть в инструментах.",
  },
  {
    title: "Промты для QA",
    meta: "для работы",
    icon: "/images/pixel-robot.svg",
    text: "Не “напиши тесты”, а нормальные запросы для требований, рисков, тестов и проверки ответа AI.",
  },
  {
    title: "AI QA project",
    meta: "для портфолио",
    icon: "/images/pixel-cv.svg",
    text: "Соберёшь проект, который показывает: ты умеешь не только писать тест-кейсы, но и проверять AI.",
  },
  {
    title: "Roadmap",
    meta: "30 дней",
    icon: "/images/pixel-map.svg",
    text: "Поймёшь, что делать manual, junior или middle QA, чтобы перейти к AI без паники и хаоса.",
  },
];
---

<section class="section" id="inside">
  <SectionHeading
    eyebrow="Что внутри"
    title="Это не PDF про ChatGPT. Это понятный план, что делать QA с AI"
    text="Внутри не обещание “AI всё сделает за тебя”, а практический маршрут: поставить задачу, проверить ответ, сделать первые проверки и собрать проект."
  />
  <div class="inside-grid">
    {items.map((item) => (
      <article class="content-card reveal">
        <img class="pixel-card-icon" src={item.icon} alt="" loading="lazy" />
        <div>
          <span>{item.meta}</span>
          <h3>{item.title}</h3>
        </div>
        <p>{item.text}</p>
        <a href="#pricing" aria-label={`Выбрать тариф для ${item.title}`}>↗</a>
      </article>
    ))}
  </div>
</section>
