---
import SectionHeading from "@/components/SectionHeading.astro";
import { ragMetrics } from "@/data/site";
---

<section class="section rag-section" id="rag">
  <SectionHeading
    eyebrow="RAG-диагностика"
    title="Сначала пойми, где ты сейчас по AI-навыкам — а потом качай нужное"
    text="Простая шкала Red → Amber → Green: где зона риска, где переход, а где уже рабочая система применения AI в тестировании. Без неё легко учить не то."
  />
  <div class="rag-grid">
    {ragMetrics.map((item) => (
      <article class:list={["rag-card reveal", item.status]}>
        <div class="rag-top">
          <span>{item.label}</span>
          <h3>{item.title}</h3>
        </div>
        <p>{item.text}</p>
        <div class="key-list" aria-label={`Ключи ${item.label}`}>
          {item.keys.map((key) => <small>{key}</small>)}
        </div>
      </article>
    ))}
  </div>
</section>
