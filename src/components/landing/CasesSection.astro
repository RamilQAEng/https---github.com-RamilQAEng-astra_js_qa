---
import SectionHeading from "@/components/SectionHeading.astro";
import { cases, testimonials } from "@/data/site";
---

<section class="section" id="proof">
  <SectionHeading
    eyebrow="Ситуации QA"
    titleHtml="Узнаваемые сценарии: где <span class='accent-text'>AI усиливает QA</span>, а где создает риск"
    text="Здесь не обещания и не “истории успеха”, а конкретные рабочие ситуации: резюме, портфолио, хаотичное использование ChatGPT и переход от обычных test cases к навыкам AI QA."
  />
  <div class="case-grid">
    {cases.map((item) => (
      <article class="case-card reveal">
        <span>{item.role}</span>
        <h3>{item.title}</h3>
        <p>{item.result}</p>
      </article>
    ))}
  </div>
  <div class="testimonial-row">
    {testimonials.map((item) => (
      <article class="testimonial-card reveal">
        <p>“{item.text}”</p>
        <div>
          <strong>{item.name}</strong>
          <span>{item.role}</span>
        </div>
      </article>
    ))}
  </div>
</section>
