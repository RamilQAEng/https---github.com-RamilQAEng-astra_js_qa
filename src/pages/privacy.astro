---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<BaseLayout title="Политика конфиденциальности" noindex={true}>
  <Header />
  <main class="legal-page" id="top">
    <section class="section legal-content">
      <h1>Политика конфиденциальности</h1>
      <p>Черновик. Перед запуском замените этот текст на юридически корректную политику с данными продавца.</p>
      <p>Сайт может собирать контактные данные, данные оплаты и технические данные аналитики для обработки заказа и улучшения рекламы.</p>
    </section>
  </main>
  <Footer />
</BaseLayout>
