---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { site } from "@/data/site";

const nextSteps = [
  "Скачай материалы и сохрани ссылку.",
  "Открой roadmap и отметь свой текущий уровень.",
  "Подпишись на TG/VK: туда будем выкладывать обновления и разборы.",
];
---

<BaseLayout
  title="Спасибо за покупку"
  description="Страница успешной оплаты AI QA гайда. Здесь можно скачать материалы и перейти в Telegram."
  noindex={true}
>
  <Header />
  <main class="thank-page" id="top">
    <section class="section thank-hero">
      <div class="thank-card reveal">
        <div class="thank-copy">
          <p class="eyebrow">Оплата прошла</p>
          <h1>Спасибо. Твой AI QA набор готов.</h1>
          <p>
            Скачай материалы сейчас. Ссылку также лучше сохранить: если что-то не откроется,
            напиши в поддержку, и мы продублируем доступ.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="/downloads/ai-qa-guide-sample.pdf" download>Скачать материалы</a>
            <a class="button ghost" href="/">На главную</a>
            <a class="button ghost" href={`mailto:${site.supportEmail}`}>Написать в поддержку</a>
          </div>
        </div>

        <div class="thank-side">
          <div class="download-ticket">
            <span>Access</span>
            <strong>AI QA Kit</strong>
            <p>PDF • промты • roadmap • CV</p>
          </div>
          <div class="mini-steps">
            {nextSteps.map((step, index) => (
              <div>
                <span>{index + 1}</span>
                <p>{step}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="thank-social reveal">
        <div>
          <p class="eyebrow">Следующий шаг</p>
          <h2>Подпишись, чтобы получать обновления и новые QA-промты</h2>
          <p>
            В каналах будем публиковать разборы, дополнительные промты, обновления гайда
            и заметки по AI-инструментам для тестировщиков.
          </p>
        </div>
        <div class="soft-cta-actions">
          <a class="button primary" href={site.telegramUrl}>Telegram</a>
          <a class="button ghost" href={site.vkUrl}>VK</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
