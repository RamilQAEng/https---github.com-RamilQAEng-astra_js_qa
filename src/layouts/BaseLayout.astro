---
import "../styles/global.css";
import { site as defaultSite } from "@/data/site";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title = defaultSite.title,
  description = defaultSite.description,
  canonical = Astro.url.href,
  noindex = false,
} = Astro.props;
const pageTitle = title === defaultSite.name ? title : `${title} | ${defaultSite.name}`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={defaultSite.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      name: "AI QA гайд и промты",
      description,
      brand: defaultSite.name,
      offers: {
        "@type": "AggregateOffer",
        lowPrice: "990",
        highPrice: "2990",
        priceCurrency: "RUB",
      },
    })} />
  </head>
  <body>
    <slot />
    <a class="back-to-top" href="#top" aria-label="Наверх">↑</a>
    <div class="cookie-banner" data-cookie-banner hidden>
      <div>
        <strong>Cookies и аналитика</strong>
        <p>
          Используем технические cookies/localStorage и аналитику, чтобы сайт работал стабильнее
          и реклама не стреляла вслепую.
        </p>
      </div>
      <div class="cookie-actions">
        <a class="button ghost" href="/cookies/">Подробнее</a>
        <button class="button primary" type="button" data-cookie-accept>Ок</button>
      </div>
    </div>
    <script>
      const revealItems = document.querySelectorAll(".reveal");
      const show = (el) => el.classList.add("is-visible");

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                show(entry.target);
                observer.unobserve(entry.target);
              }
            });
          },
          // появляться как только край блока вошёл в экран — порог 0,
          // чтобы высокие карточки на мобилке не застревали невидимыми
          { threshold: 0, rootMargin: "0px 0px -40px 0px" },
        );

        revealItems.forEach((item) => observer.observe(item));

        // страховка: всё, что уже в зоне видимости при загрузке — показать сразу
        requestAnimationFrame(() => {
          revealItems.forEach((item) => {
            const rect = item.getBoundingClientRect();
            if (rect.top < window.innerHeight) show(item);
          });
        });
      } else {
        revealItems.forEach(show);
      }

      const cookieBanner = document.querySelector("[data-cookie-banner]");
      const cookieAccept = document.querySelector("[data-cookie-accept]");
      const cookieKey = "qaai_cookie_notice_accepted";

      if (cookieBanner && localStorage.getItem(cookieKey) !== "yes") {
        cookieBanner.hidden = false;
      }

      cookieAccept?.addEventListener("click", () => {
        localStorage.setItem(cookieKey, "yes");
        if (cookieBanner) cookieBanner.hidden = true;
      });
    </script>
  </body>
</html>
